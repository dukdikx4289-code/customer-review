# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า  (ห้าม commit .env)
# ค่าด้านล่างเป็นค่าสำหรับพัฒนาในเครื่อง (Docker MySQL) เท่านั้น

NODE_ENV=development
PORT=3000

# --- Database (Docker MySQL ในเครื่อง = 3306, TiDB Cloud = 4000 + DB_SSL=true) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=review
DB_PASSWORD=review_dev_pw
DB_NAME=customer_review
DB_SSL=false
# connection สูงสุดต่อ instance (Render 10 · Vercel Functions ใช้ 3)
DB_POOL_MAX=10

# --- Secrets: สร้างด้วย  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))" ---
SESSION_SECRET=change-me-to-a-long-random-string-32chars-min
# เปลี่ยนค่านี้ภายหลัง = ลิงก์/QR ที่แจกไปแล้วทั้งหมดใช้ไม่ได้
LINK_SIGNING_SECRET=change-me-to-another-long-random-string-32chars

# --- URL ที่ลูกค้า/ผู้บริหารเปิด (ใช้สร้างลิงก์และ QR) ---
PUBLIC_BASE_URL=http://localhost:3000
# จำนวน proxy ที่อยู่หน้าเซิร์ฟเวอร์ (Vercel -> Render = 2, ในเครื่อง = 0)
TRUST_PROXY_HOPS=0

# --- Google Sheets (เว้นว่างไว้ได้ถ้ายังไม่ใช้ และตั้ง SHEETS_SYNC_ENABLED=false) ---
# ตั้งค่า 3 ตัวด้านล่างให้อัตโนมัติด้วย:  npm run sheets:setup -- --key <ไฟล์ key.json> --sheet <URL ชีท>   (ดู docs/google-sheets.md)
SHEETS_SYNC_ENABLED=false
SHEETS_SYNC_INTERVAL_SEC=30
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# --- Dashboard ---
DASHBOARD_CACHE_TTL_SEC=60

# --- ใช้เฉพาะตอนรัน  npm run db:seed  เพื่อสร้างแอดมินคนแรก แล้วลบออกจาก env ---
ADMIN_BOOTSTRAP_USER=
ADMIN_BOOTSTRAP_PASSWORD=
